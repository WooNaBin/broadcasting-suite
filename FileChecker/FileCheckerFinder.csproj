<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>FileCheckerFinder</AssemblyName>
    <Product>FileCheckerFinder</Product>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)/assets/app.ico')">assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier) != '' AND $(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Start-FileCheckerFinder.bat">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Update="assets/**/*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
