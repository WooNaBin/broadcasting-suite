<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>WorkLog</AssemblyName>
    <Product>WorkLog</Product>
    <AssemblyTitle>WorkLog</AssemblyTitle>
    <Description>Church broadcasting work log — macOS NAS bridge</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\www\index.html" LogicalName="WorkLog.index.html" />
    <EmbeddedResource Include="..\www\styles.css" LogicalName="WorkLog.styles.css" />
    <EmbeddedResource Include="..\www\app.js" LogicalName="WorkLog.app.js" />
    <EmbeddedResource Include="..\www\templates.js" LogicalName="WorkLog.templates.js" />
  </ItemGroup>
</Project>
