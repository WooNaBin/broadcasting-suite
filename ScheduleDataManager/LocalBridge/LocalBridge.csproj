<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>BroadcastingSchedule</AssemblyName>
    <Product>Broadcasting Schedule</Product>
    <AssemblyTitle>Broadcasting Schedule</AssemblyTitle>
    <AssemblyProduct>Broadcasting Schedule</AssemblyProduct>
    <Description>Broadcasting Schedule — shared planning workspace</Description>
    <ApplicationIcon>BroadcastingSchedules.ico</ApplicationIcon>
    <ApplicationTitle>Broadcasting Schedule</ApplicationTitle>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier) != '' AND $(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\index.html" LogicalName="ScheduleDataManager.index.html" />
    <EmbeddedResource Include="..\styles.css" LogicalName="ScheduleDataManager.styles.css" />
    <EmbeddedResource Include="..\app.js" LogicalName="ScheduleDataManager.app.js" />
    <EmbeddedResource Include="..\sw.js" LogicalName="ScheduleDataManager.sw.js" />
    <EmbeddedResource Include="..\assets\icons\*.png" LogicalName="ScheduleDataManager.assets.icons.%(Filename)%(Extension)" />
    <Content Include="BroadcastingSchedules.ico" />
  </ItemGroup>
</Project>
