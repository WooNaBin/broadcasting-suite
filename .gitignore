# 방송실 메타 레포 — 앱 소스·빌드 산출물은 추적하지 않음

# 독립 앱 레포 (각각 자체 .git)
/CtrlOne/
/FileChecker/
/ScheduleDataManager/
/ScheduleReader/
/WorkLog/

# 스위트 밖
/ImgToText/

# 빌드 산출물·임시
/Builded/
**/_stage/
**/_build/
**/_bundle_stage/
publish/
**/bin/
**/obj/
**/.vs/

# Python / 로컬 (앱 레포는 위에서 통째 ignore — Models/Input/Output 과 대소문자 충돌 나는 광역 규칙 금지)
**/.venv/
**/__pycache__/
**/.pytest_cache/

# 설정·비밀 (파일 단위 — Data/ 소스 폴더와 충돌 최소화)
**/.env
**/.env.*
**/devices.json
**/presets.json
**/data/settings.json
**/data/schedules.json
**/data/filechecker-settings.json
**/data/files/**

# BroadcastNasBridge — sync-ui 산출물·런타임 (폴더 전체 data/ 금지 → Data/ 와 충돌)
/BroadcastNasBridge/wwwroot/schedule/
/BroadcastNasBridge/wwwroot/worklog/
/BroadcastNasBridge/wwwroot/files/
/BroadcastNasBridge/data/files/
/BroadcastNasBridge/data/*.json

# OS / 에디터
Thumbs.db
Desktop.ini
*.user
*.suo
.DS_Store
.vscode/

# local build helpers
/tools/

# 머신별 빌드 산출 경로 (예시는 broadcast-suite.build.example.json)
/broadcast-suite.build.json

